{
  "name": "asobuild",
  "version": "0.1.0",
  "private": true,
  "description": "アソビルド — 制約つきでミニゲーム/ツールを量産する器",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p ${PORT:-3020}",
    "dev:rec": "node scripts/rec.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "new": "node scripts/new-game.mjs",
    "say": "node scripts/live.mjs say",
    "live": "node scripts/live.mjs",
    "fun": "tsx scripts/fun-check.ts",
    "fun:all": "tsx scripts/fun-check.ts --all",
    "tune": "tsx scripts/tune.ts",
    "ogp": "tsx scripts/gen-ogp.ts",
    "playtest": "tsx scripts/playtest.ts",
    "ship": "npm run check && tsx scripts/ship-check.ts",
    "status": "tsx scripts/status.ts",
    "selftest": "tsx scripts/selftest.ts",
    "check": "npm run typecheck && npm run lint && npm run selftest && npm run fun:all && npm run build",
    "snap": "tsx scripts/snap.ts"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "16.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
