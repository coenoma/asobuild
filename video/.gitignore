node_modules/
out/

# 元素材と切り出した素材は置かない（PUBLIC リポジトリ／サイズも大きい）
public/footage/

# 効果音は scripts/sfx.mjs で作れるので持たない
public/sfx/

# 書体は node scripts/fonts.mjs で取ってくる
public/fonts/

# 声のwavは持たない（確認用は voice.mjs --synth で作れる。本命の人の声も置き場所は同じ）
# 原稿（voice/*.json）は持つ
voice/*/

# BGM は持たない（PUBLIC なので音源の再配布になる）。
# 手元の bgm/main.mp3 と bgm/ending.wav を、書き出しのときだけ混ぜる。
# どこから持ってきたかと、概要欄に書くクレジットは docs/video/sound-design.md
bgm/
