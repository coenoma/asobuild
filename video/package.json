{
  "name": "asobuild-video",
  "version": "0.1.0",
  "private": true,
  "description": "アソビルドの動画を組み立てる器（Remotion）。編集はコードではなく edl/*.json で決める",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "studio": "node scripts/episode.mjs studio",
    "draft": "node scripts/episode.mjs draft",
    "build": "node scripts/episode.mjs build",
    "prep": "node scripts/episode.mjs prep",
    "timeline": "node scripts/timeline.mjs",
    "extract": "node scripts/extract.mjs",
    "sfx": "node scripts/sfx.mjs",
    "scan": "node scripts/scan-risk.mjs",
    "typecheck": "tsc --noEmit",
    "storyboard": "node scripts/storyboard.mjs"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.512",
    "@remotion/google-fonts": "^4.0.512",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "^4.0.512"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "typescript": "5.9.3"
  }
}
